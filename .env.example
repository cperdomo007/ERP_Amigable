GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ERP_AmigableDB
MYSQL_USER=root
MYSQL_PASSWORD=
# Nube: tiene prioridad sobre MYSQL_*. Render utiliza la URL pública de Railway.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=
ERP_HOST=127.0.0.1
PORT=3002
ERP_SERVE_WEB=false
ERP_FILE_BACKUPS=true
# Orígenes del frontend web, separados por coma. La web debe publicar /api/erp en su mismo origen.
ERP_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Activar detrás de HTTPS para que la cookie web solo viaje por conexiones seguras.
ERP_SECURE_COOKIES=false
